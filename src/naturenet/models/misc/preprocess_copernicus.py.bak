def interpolate_filled_pixels(matrix, missing_value=np.nan, method="linear"):
    """
    Fill missing pixels in a 2D matrix by interpolating from known pixels.

    Parameters
    ----------
    matrix : np.ndarray
        2D input array.
    missing_value : float or int, default np.nan
        Value used to mark missing pixels. If np.nan, NaNs are treated as missing.
    method : str, default "linear"
        Interpolation method: "nearest", "linear", or "cubic".

    Returns
    -------
    filled : np.ndarray
        Matrix with missing pixels interpolated.
    """
    matrix = np.asarray(matrix, dtype=float)

    if np.isnan(missing_value):
        mask_missing = np.isnan(matrix)
    else:
        mask_missing = matrix == missing_value

    if not np.any(mask_missing):
        return matrix.copy()

    rows, cols = matrix.shape
    yy, xx = np.meshgrid(np.arange(rows), np.arange(cols), indexing="ij")

    known_points = np.column_stack((yy[~mask_missing], xx[~mask_missing]))
    known_values = matrix[~mask_missing]

    missing_points = np.column_stack((yy[mask_missing], xx[mask_missing]))

    filled = matrix.copy()

    interp_values = griddata(
        known_points,
        known_values,
        missing_points,
        method=method
    )

    if np.any(np.isnan(interp_values)):
        bicubic_values = griddata(
            known_points,
            known_values,
            missing_points[np.isnan(interp_values)],
            method="cubic"
        )
        interp_values[np.isnan(interp_values)] = bicubic_values

    filled[mask_missing] = interp_values
    return filled


def resample_or_fuse_scene(scene, init_location, resample_config):

    resample_config["low_res"]["filenames"] = scene
    resample_config["low_res"]["geo_filenames"] = scene


    resample_config["return_products"] = True
    output, location = resample_scene(scene, init_location, resample_config)
    return output, location

